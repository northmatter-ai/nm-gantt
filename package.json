{
  "name": "nm-gantt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @northmatter-ai/gantt-demo dev",
    "build": "pnpm --filter @northmatter-ai/gantt-demo build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "licenses": "node scripts/check-licenses.mjs",
    "ci": "pnpm typecheck && pnpm test && pnpm run licenses && pnpm e2e",
    "e2e": "pnpm --filter @northmatter-ai/gantt-demo exec playwright test",
    "preview": "pnpm --filter @northmatter-ai/gantt-demo build && pnpm --filter @northmatter-ai/gantt-demo preview",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "check:packages": "pnpm build:packages && node scripts/check-packages.mjs",
    "release": "pnpm run ci && pnpm check:packages && pnpm -r --filter \"./packages/*\" publish --access public",
    "set-version": "node scripts/set-version.mjs",
    "release:dry": "pnpm check:packages && pnpm -r --filter \"./packages/*\" publish --access public --dry-run --no-git-checks",
    "pack:local": "pnpm build:packages && rm -rf ../nm-tgz && mkdir -p ../nm-tgz && pnpm -r --filter \"./packages/*\" exec pnpm pack --pack-destination ../../../nm-tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
